{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "near-hotdog-web4-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-04-16",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "hotdog.icypee.xyz",
      "custom_domain": true
    }
  ],
  "vars": {
    "CONTRACT_ID": "hotdog-icypee.testnet",
    "NEAR_RPC_URL": "https://rpc.testnet.near.org"
  }
}
